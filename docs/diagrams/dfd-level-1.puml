@startuml
skinparam monochrome true
skinparam shadowing false
skinparam rectangle {
  roundCorner 0
}
hide <<process>> stereotype
skinparam rectangle<<process>> {
  roundCorner 50
}
title Civic Issue Tracker - Data Flow Diagram: Level 1

rectangle Citizen as E1
rectangle Administrator as E2
rectangle "Department\nStaff" as E3

rectangle "P1\nUser\nAuthentication" as P1 <<process>>
rectangle "P2\nIssue\nReporting" as P2 <<process>>
rectangle "P3\nIssue Search\n& Map Display" as P3 <<process>>
rectangle "P4\nIssue Management\n& Status Updates" as P4 <<process>>
rectangle "P5\nUpvote\nProcessing" as P5 <<process>>
rectangle "P6\nNotifications\n& Analytics" as P6 <<process>>

rectangle "D1 Users" as D1
rectangle "D2 Issues" as D2
rectangle "D3 Issue Images" as D3
rectangle "D4 Status History" as D4
rectangle "D5 Upvotes" as D5
rectangle "D6 Notifications" as D6
rectangle "D7 Departments\n& Assignments" as D7
rectangle "D8 Sectors\n& Categories" as D8

E1 --> P1 : registration / login
E2 --> P1 : login
E3 --> P1 : login
P1 --> D1 : write new user
D1 --> P1 : read credentials / account
P1 --> E1 : token
P1 --> E2 : token
P1 --> E3 : token

E1 --> P2 : issue report + photo + pin
D8 --> P2 : read sector / category data
P2 --> D2 : write issue record
P2 --> D3 : write image file
P2 --> D6 : write submission notice
P2 --> E1 : public ID + confirmation

E1 --> P3 : search / filter / map request
D2 --> P3 : read matching issues
P3 --> E1 : issue list / pinned markers

E2 --> P4 : status change / assignment
E3 --> P4 : progress / resolution update
P4 --> D2 : write new status
P4 --> D4 : append history entry
P4 --> D7 : write assignment
D7 --> P4 : read active assignments
P4 --> D6 : write status notification

E1 --> P5 : upvote / remove upvote
P5 --> D5 : write / delete vote (unique per user)
D5 --> P5 : read vote count
P5 --> E1 : supporter count

D2 --> P6 : read issues for statistics
D4 --> P6 : read history for resolution times
D6 --> P6 : read / mark notifications
P6 --> D6 : write announcements / notices
P6 --> E1 : notifications
P6 --> E2 : dashboard analytics, notifications
P6 --> E3 : notifications
@enduml
