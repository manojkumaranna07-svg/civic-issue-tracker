@startuml
skinparam monochrome true
skinparam shadowing false
skinparam rectangle {
  roundCorner 0
}
hide <<process>> stereotype
skinparam rectangle<<process>> {
  roundCorner 50
}
title Civic Issue Tracker - DFD Level 2: P2 Issue Reporting

rectangle Citizen as E1

rectangle "P2.1\nValidate\nInput" as P21 <<process>>
rectangle "P2.2\nValidate &\nStore Image" as P22 <<process>>
rectangle "P2.3\nStore Issue\nRecord" as P23 <<process>>
rectangle "P2.4\nGenerate\nPublic ID" as P24 <<process>>
rectangle "P2.5\nCreate\nNotifications" as P25 <<process>>

rectangle "D2 Issues" as D2
rectangle "D3 Issue Images" as D3
rectangle "D6 Notifications" as D6
rectangle "D8 Sectors\n& Categories" as D8

E1 --> P21 : report form (title, sector,\ncategory, description, location, pin)
D8 --> P21 : read sector / category pairing
P21 --> E1 : validation errors (if any)
P21 --> P22 : optional photo
P22 --> E1 : image rejected (type / size invalid)
P22 --> D3 : write image under safe name
P21 --> P23 : validated fields
P23 --> D2 : write issue (status = Reported)
D2 --> P24 : new record id
P24 --> D2 : write public ID
P24 --> P25 : issue reference
P25 --> D6 : write reporter + admin notices
P25 --> E1 : confirmation + tracking ID
@enduml
