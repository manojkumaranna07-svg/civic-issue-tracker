# Copy to .env and adjust. Never commit the real .env file.
# Secret used to sign authentication tokens - CHANGE THIS for any real deployment.
SECRET_KEY=dev-secret-change-me
# Token lifetime in hours
TOKEN_EXPIRE_HOURS=24
# SQLite database location (default: backend/civic.db)
# DATABASE_URL=sqlite:////absolute/path/to/civic.db
# Upload constraints
MAX_UPLOAD_BYTES=5242880
